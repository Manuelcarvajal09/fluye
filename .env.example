# Copia este archivo a .env.local y rellénalo con TUS valores. Nunca subas .env.local.

# Postgres (Neon u otro). Ejemplo ficticio:
DATABASE_URL=postgresql://usuario:contrasena@ep-ejemplo.us-east-2.aws.neon.tech/fluye?sslmode=require

# Clerk (https://dashboard.clerk.com) — claves de TU aplicación.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ids de usuario de Clerk que administran invitaciones (coma). Ejemplo ficticio:
OWNER_USER_IDS=user_XXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL pública de la app (invitaciones y dominio autorizado en producción).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: preconfigurar perfiles por correo (JSON). Ejemplo ficticio:
# PROFILE_PRESETS={"ana@example.com":{"name":"Ana","level":"A2","topics":["conversacion","viajes"],"goalMinutes":10}}
